[Unit]
Description=ESConv Likert user evaluation survey
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ito
WorkingDirectory=/home/ito/Master2
Environment=HOST=0.0.0.0
Environment=PORT=8503
ExecStart=/home/ito/Master2/scripts/run_esconv_likert_user_eval_web.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
